<Window x:Class="Drilling.UI.Popup.CMelsecStageSimulationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Melsec Simulator" Width="1020" Height="840" MinWidth="900" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" FontFamily="Segoe UI"
        Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Background="{DynamicResource ButtonSecondaryBrush}"
            BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" BorderThickness="1" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Melsec Simulator" FontSize="24" FontWeight="SemiBold" />
            <StackPanel Grid.Row="1" Margin="0,10,0,16">
                <TextBlock Text="{Binding ConnectionText}" FontSize="14" FontWeight="SemiBold" />
                <TextBlock Text="SIMULATION Stage 입력. ALIGN 허가/완료: 원시값 10000 → 1 / WFAB3: 2=ALIGN BUSY, 0=해제 / Tray Count: 원시 정수."
                           Margin="0,6,0,0" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" />
                <CheckBox Content="Process Move / IOF Stage 자동 응답" IsChecked="{Binding AutomaticReplies}"
                          IsEnabled="{Binding CanChangeAutomaticReplies}" FontSize="14" Margin="0,8,0,0" />
                <TextBlock Text="수동 신호 시험은 자동 응답을 끄고 시작하세요. DoReady / Process / Review 요청은 계속 직접 변경합니다."
                           Margin="0,5,0,0" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                    <TextBlock Text="0선 촬영구간 완료 (수동 시뮬)" VerticalAlignment="Center" FontSize="12" />
                    <TextBox Text="{Binding ZeroSegmentInput, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSetZeroSegments}"
                             Width="48" Height="26" Margin="9,0,5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                    <Button Content="SET" Command="{Binding SetZeroSegmentsCommand}" Width="58" Height="26" />
                    <TextBlock Text="{Binding ZeroSegmentState}" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <DataGrid x:Name="SignalGrid" Grid.Row="2" ItemsSource="{Binding Rows}"
                      Style="{StaticResource PlainDataGrid}" IsReadOnly="True" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                      CanUserReorderColumns="False" CanUserSortColumns="False"
                      RowHeight="34" ColumnHeaderHeight="34" FontSize="13"
                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Description}" />
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Resources>
                    <Style x:Key="SignalText" TargetType="TextBlock">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Setter Property="Margin" Value="8,0" />
                    </Style>
                    <Style x:Key="SignalButton" TargetType="Button">
                        <Setter Property="Margin" Value="4,3" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="White" />
                        <Setter Property="BorderThickness" Value="0" />
                    </Style>
                    <Style x:Key="SignalActionCell" TargetType="DataGridCell" BasedOn="{StaticResource PlainDataGridCell}">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Scenario" Binding="{Binding Scenario}" Width="125" ElementStyle="{StaticResource SignalText}" />
                    <DataGridTextColumn Header="Stage Signal" Binding="{Binding Name}" Width="*" ElementStyle="{StaticResource SignalText}" />
                    <DataGridTextColumn Header="Address" Binding="{Binding Address}" Width="170" ElementStyle="{StaticResource SignalText}" />
                    <DataGridTemplateColumn Header="Current" Width="155">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding CurrentValue}" Foreground="{Binding StateBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Input (Raw)" Width="210" CellStyle="{StaticResource SignalActionCell}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid>
                                    <UniformGrid x:Name="BinaryInput" Columns="2">
                                        <Button Content="ON" Background="#287D49" Style="{StaticResource SignalButton}" Command="{Binding SetOnCommand}" />
                                        <Button Content="OFF" Background="#A27614" Style="{StaticResource SignalButton}" Command="{Binding SetOffCommand}" />
                                    </UniformGrid>
                                    <Grid x:Name="NumericInput" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="60" /></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding InputValue, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanSet}"
                                                 Margin="4,3" Padding="5,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"
                                                 Background="{DynamicResource GridBackgroundBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                                                 BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" ToolTip="원시 정수: 0~65535" />
                                        <Button Grid.Column="1" Content="SET" Background="{DynamicResource ButtonPrimaryBrush}"
                                                Style="{StaticResource SignalButton}" Command="{Binding SetValueCommand}" />
                                    </Grid>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsNumeric}" Value="True">
                                        <Setter TargetName="BinaryInput" Property="Visibility" Value="Collapsed" />
                                        <Setter TargetName="NumericInput" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <Button Grid.Row="3" Content="CLOSE" Width="120" Height="40" HorizontalAlignment="Right"
                    Margin="0,16,0,0" FontSize="14" FontWeight="SemiBold"
                    Background="{DynamicResource ButtonSecondaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
                    BorderBrush="{DynamicResource ButtonSecondaryBorderBrush}" Click="CloseClicked" />
        </Grid>
    </Border>
</Window>
