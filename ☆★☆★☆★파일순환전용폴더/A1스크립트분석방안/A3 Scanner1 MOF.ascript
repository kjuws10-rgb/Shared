end

function Laser_On_Off( $MoveDelay as real, $LaserOnTime as real, $LaserOffDelay as real)

	MoveDelay(GX, $MoveDelay)
	GalvoLaserOutput(GX, GalvoLaser.On)
	MoveDelay(GX, $LaserOnTime)
	GalvoLaserOutput(GX, GalvoLaser.Off)
	MoveDelay(GX, $LaserOffDelay)		
	
end
