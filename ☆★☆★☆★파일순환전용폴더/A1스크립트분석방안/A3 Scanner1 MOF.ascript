program

var $MoveDelay_ as real
var $LaserOnTime_ as real
var $LaserOffTime_ as real



// Default 

IfovOff()
SetupTaskDistanceUnits(DistanceUnits.Primary)
SetupTaskTimeUnits(TimeUnits.Seconds)
VelocityBlendingOff()
SetupTaskWaitMode(WaitMode.Auto)
SetupTaskTargetMode(TargetMode.Absolute)

PsoReset(GY) 
GalvoConfigureLaserOutputPeriod(GY, 0)
GalvoConfigureLaser1PulseWidth(GY, 0)
GalvoConfigureLaserMode(GY, 0)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.MotionUpdateRate, 100)
ParameterSetTaskValue(TaskGetIndex(), TaskParameter.ExecuteNumLines, 110)
GalvoEncoderScaleFactorSet(GY, 0)
WaitForInPosition([GX, GY])



// Moveing Profile
ParameterSetAxisValue(GX, AxisParameter.MaxSpeedClamp, 100000)
ParameterSetAxisValue(GY, AxisParameter.MaxSpeedClamp, 100000)
ParameterSetAxisValue(GX, AxisParameter.VelocityCommandThreshold, 100000)
ParameterSetAxisValue(GY, AxisParameter.VelocityCommandThreshold, 100000)

SetupCoordinatedAccelLimit(17000000,17000000)
SetupAxisRampType([GY,GX], RampType.Sine)
SetupAxisRampValue([GY,GX], RampMode.Rate, 17000000)
SetupCoordinatedRampType(RampType.Sine)
SetupCoordinatedRampValue(RampMode.Rate,17000000)
SetupCoordinatedSpeed(900)

SetupAxisSpeed(GY, 20000)
SetupAxisSpeed(GX, 20000)


 // Before MOF Enable , GX, GY move to zoro pos.
MoveRapid([GY,GX], [0,0])
WaitForInPosition([GX, GY])
MoveDelay(GX, 1)
AnalogOutputSet(GY, 0, 10)


// Laser condition
GalvoConfigureLaserOutputPeriod(GY, 5)
GalvoConfigureLaser1PulseWidth(GY, 10)
GalvoConfigureLaserDelays(GY, 0.000, 0.000)
GalvoConfigureLaserMode(GY, 0)

$MoveDelay_ = 0.8
$LaserOnTime_ = 0.2
$LaserOffTime_ = 0.2

// Stage Setting and Moving (only Aerotech Stage )
