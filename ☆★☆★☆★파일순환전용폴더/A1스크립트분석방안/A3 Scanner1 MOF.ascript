WaitForMotionDone([X, Y])
ParameterSetAxisValue(Y,AxisParameter.PrimaryEmulatedQuadratureDivider, 6.25)
DriveSetAuxiliaryFeedback(GY, 0)
GalvoEncoderScaleFactorSet(GY, ParameterGetAxisValue(GY, AxisParameter.CountsPerUnit) / 16000)
SetupAxisRampType(Y, RampType.Sine)
SetupAxisRampValue(Y, RampMode.Rate, 1000)

// Start MOF.
